@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using System.Net
@inject IJSRuntime JS
@inject AuthService AuthService
@inject AppointmentService AppointmentService
@inject NavigationManager NavigationManager

<PageTitle>Planno</PageTitle>

<div class="app">
    <CalendarHeader Date="_date"
                    View="_view"
                    ViewChanged="SetView"
                    OnToday="Today"
                    OnPrev="() => Shift(-1)"
                    OnNext="() => Shift(1)"
                    OnMenu="ToggleSidebar"
                    SidebarOpen="_sidebarOpen" />

    <div class="body">
        <aside class="sidebar @(_sidebarOpen ? "" : "collapsed")">
            <button class="create" type="button" aria-label="Termin" title="Termin" @onclick="OpenCreate">
                <Icon Name="add" />
                <span>Termin</span>
            </button>

            <MiniCalendar @bind-Selected="_date" />
        </aside>

        @if (_view is CalendarView.Day or CalendarView.Week)
        {
            <WeekView Date="_date"
                      DayCount="@(_view == CalendarView.Day ? 1 : 7)"
                      Appointments="_appointments"
                      Draft="@(_createOpen && _editing is null ? _draft : null)"
                      OnDayPicked="OpenDay"
                      OnCreate="BeginCreate"
                      OnAppointmentClick="OpenEdit"
                      OnAppointmentMove="MoveAppointment" />
        }
        else if (_view == CalendarView.Month)
        {
            <PageScroller PageKey="MonthKey" OnPage="Shift">
                <MonthView Date="_date"
                           Appointments="_appointments"
                           OnDayPicked="OpenDay"
                           OnAppointmentClick="OpenEdit"
                           OnAppointmentMove="MoveAppointment" />
            </PageScroller>
        }
        else
        {
            <PageScroller PageKey="YearKey" OnPage="Shift">
                <YearView Date="_date"
                          Appointments="_appointments"
                          OnDayPicked="OpenDay"
                          OnMonthPicked="OpenMonth" />
            </PageScroller>
        }
    </div>

    @if (_createOpen)
    {
        <AppointmentEditor @key="_windowKey"
                                 Date="_date"
                                 Existing="_editing"
                                 InitialStart="_slotStart"
                                 InitialEnd="_slotEnd"
                                 OnClose="CloseCreate"
                                 OnSave="@(app => SaveAppointment(app))"
                                 OnDelete="DeleteEditing"
                                 OnPreview="SetDraft" />
    }
</div>

@code {
    private DateTime _date = DateTime.Today;
    private CalendarView _view = CalendarView.Week;
    private bool _sidebarOpen = true;
    private List<AppointmentResponse> _appointments = new();

    private bool _createOpen;
    private int _windowKey;
    private AppointmentResponse? _editing;
    private DateTime? _slotStart, _slotEnd;
    private TimeSlot? _draft;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _self;

    private DateTime MonthKey => new(_date.Year, _date.Month, 1);
    private DateTime YearKey => new(_date.Year, 1, 1);

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void OpenCreate()
    {
        _editing = null;
        _slotStart = _slotEnd = null;
        ShowWindow();
    }

    private void BeginCreate(TimeSlot slot)
    {
        _editing = null;
        _slotStart = slot.Start;
        _slotEnd = slot.End;
        ShowWindow();
    }

    private void OpenEdit(int id)
    {
        var appointment = _appointments.FirstOrDefault(a => a.Id == id);
        if (appointment is null) return;

        _editing = appointment;
        _slotStart = _slotEnd = null;
        _draft = null;
        ShowWindow();
    }

    private void ShowWindow()
    {
        _windowKey++;
        _createOpen = true;
    }

    private void CloseCreate()
    {
        _createOpen = false;
        _editing = null;
        _slotStart = _slotEnd = null;
        _draft = null;
    }

    private void SetDraft(TimeSlot? slot) => _draft = slot;

    protected override async Task OnInitializedAsync()
    {
        string? token = await AuthService.GetTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            _appointments = await AppointmentService.GetAppointmentListAsync() ?? new();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception)
        {
            _appointments = new();
        }
    }

    private async Task SaveAppointment(AppointmentRequest request)
    {
        if (_editing is { } existing)
        {
            var updated = await AppointmentService.UpdateAppointmentAsync(existing.Id, request);
            if (updated is not null) Replace(existing.Id, updated);
        }
        else
        {
            var created = await AppointmentService.PostAppointmentAsync(request);
            if (created is not null) _appointments.Add(created);
        }

        CloseCreate();
    }

    private async Task DeleteEditing()
    {
        if (_editing is not { } existing) return;

        if (await AppointmentService.DeleteAppointmentAsync(existing.Id))
        {
            _appointments.RemoveAll(a => a.Id == existing.Id);
        }

        CloseCreate();
    }

    private async Task MoveAppointment((int Id, DateTime Start) move)
    {
        var original = _appointments.FirstOrDefault(a => a.Id == move.Id);
        if (original is null) return;

        var newStart = move.Start;
        var newEnd = newStart + (original.EndTime - original.StartTime);

        Replace(original.Id, new AppointmentResponse(original.Id, original.Title, newStart, newEnd, original.Location, original.IsAllDay));

        AppointmentResponse? saved = null;
        try
        {
            var request = new AppointmentRequest(original.Title, newStart, newEnd, original.Location ?? "", original.IsAllDay);
            saved = await AppointmentService.UpdateAppointmentAsync(original.Id, request);
        }
        catch (HttpRequestException)
        {
        }

        Replace(original.Id, saved ?? original);
    }

    private void Replace(int id, AppointmentResponse item)
    {
        var index = _appointments.FindIndex(a => a.Id == id);
        if (index >= 0) _appointments[index] = item;
    }

    private void Today() => _date = DateTime.Today;
    private void SetView(CalendarView view) => _view = view;

    private void Shift(int steps) => _date = _view switch
    {
        CalendarView.Day   => _date.AddDays(steps),
        CalendarView.Week  => _date.AddDays(7 * steps),
        CalendarView.Month => _date.AddMonths(steps),
        _                  => _date.AddYears(steps)
    };

    private void OpenDay(DateTime day)
    {
        _date = day;
        _view = CalendarView.Day;
    }

    private void OpenMonth(DateTime month)
    {
        _date = month;
        _view = CalendarView.Month;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./planno.js");
        await _module.InvokeVoidAsync("registerShortcuts", _self);
    }

    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        switch (key.ToLowerInvariant())
        {
            case "d": _view = CalendarView.Day; break;
            case "w": _view = CalendarView.Week; break;
            case "m": _view = CalendarView.Month; break;
            case "y": _view = CalendarView.Year; break;
            case "t": _date = DateTime.Today; break;
            default: return;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("unregisterShortcuts");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
