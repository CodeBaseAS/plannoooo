@inject NavigationManager Nav
@inject AuthService Auth
@inject TokenAuthenticationStateProvider AuthState

<main class="auth">
    <section class="auth-card">

        <div class="auth-intro">
            <h1 class="auth-title">@(IsLogin ? "Sign in" : "Create account")</h1>
            <p class="auth-sub">
                @(IsLogin ? "Continue to Planno" : "Plan your appointments and keep track of every week.")
            </p>
        </div>

        <div class="auth-form">
            @if (_error is not null)
            {
                <div class="auth-alert" role="alert">@_error</div>
            }
            @if (_info is not null)
            {
                <div class="auth-alert info" role="status">@_info</div>
            }

            @if (IsLogin)
            {
                <EditForm Model="_login" OnValidSubmit="SubmitLoginAsync" novalidate>
                    <DataAnnotationsValidator />

                    <div class="auth-fields">
                        <TextField Label="Email address" Type="email" Autocomplete="username" Autofocus="true"
                                   @bind-Value="_login.Email" />
                        <TextField Label="Password" Type="@PasswordType" Autocomplete="current-password"
                                   @bind-Value="_login.Password" />
                    </div>

                    <label class="check">
                        <input type="checkbox" checked="@_showPassword" @onchange="e => _showPassword = e.Value is true" />
                        <span>Show password</span>
                    </label>

                    <div class="auth-actions">
                        <a class="text-btn" href="register">Create account</a>
                        <button type="submit" class="filled-btn" disabled="@_busy">
                            @if (_busy) { <span class="spinner" aria-label="Please wait"></span> } else { <span>Sign in</span> }
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="_register" OnValidSubmit="SubmitRegisterAsync" novalidate>
                    <DataAnnotationsValidator />

                    <div class="auth-fields">
                        <TextField Label="Name" Autocomplete="name" Autofocus="true" @bind-Value="_register.Username" />
                        <TextField Label="Email address" Type="email" Autocomplete="username" @bind-Value="_register.Email" />

                        <div class="auth-row">
                            <TextField Label="Password" Type="@PasswordType" Autocomplete="new-password"
                                       Hint="At least 8 characters." @bind-Value="_register.Password" />
                            <TextField Label="Confirm" Type="@PasswordType" Autocomplete="new-password"
                                       @bind-Value="_register.ConfirmPassword" />
                        </div>
                    </div>

                    <label class="check">
                        <input type="checkbox" checked="@_showPassword" @onchange="e => _showPassword = e.Value is true" />
                        <span>Show password</span>
                    </label>

                    <div class="auth-actions">
                        <a class="text-btn" href="login">Sign in instead</a>
                        <button type="submit" class="filled-btn" disabled="@_busy">
                            @if (_busy) { <span class="spinner" aria-label="Please wait"></span> } else { <span>Register</span> }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </section>
</main>

@code {
    [Parameter, EditorRequired] public AuthMode Mode { get; set; }

    private readonly LoginModel _login = new();
    private readonly RegisterModel _register = new();

    private bool _showPassword, _busy;
    private string? _error, _info;

    private bool IsLogin => Mode == AuthMode.Login;
    private string PasswordType => _showPassword ? "text" : "password";

    private Task SubmitLoginAsync() => RunAsync(async () =>
    {
        bool success = await Auth.LoginAsync(_login.Email.Trim(), _login.Password);
        if (!success)
        {
            _error = "Invalid email address or password.";
            _login.Password = "";
            return;
        }

        AuthState.ReportStatusChange();
        Nav.NavigateTo("/");
    });

    private Task SubmitRegisterAsync() => RunAsync(async () =>
    {
        string email = _register.Email.Trim();

        await Auth.RegisterAsync(new RegisterRequest(_register.Username.Trim(), email, _register.Password));

        if (await Auth.LoginAsync(email, _register.Password))
        {
            AuthState.ReportStatusChange();
            Nav.NavigateTo("/");
        }
        else
        {
            Nav.NavigateTo("/login");
        }
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = _info = null;

        try
        {
            await action();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode switch
            {
                HttpStatusCode.Conflict   => "This email address or name is already taken.",
                HttpStatusCode.BadRequest => "Please check your inputs.",
                null                      => "The server is unreachable. Please try again later.",
                _                         => "Something went wrong. Please try again."
            };
        }
        finally
        {
            _busy = false;
        }
    }
}