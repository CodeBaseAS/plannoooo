@page "/upgrade"
@page "/upgrade/{Tab}"

@inject AuthService AuthService
@inject DownloadService DownloadService
@inject SubscriptionService SubscriptionService
@inject PaymentService PaymentService
@inject InvoiceService InvoiceService
@inject NavigationManager Nav

<PageTitle>@(IsInvoices ? "Subscriptions & Invoices" : "Upgrade") – Planno</PageTitle>

<div class="billing">
    <header class="billing-top">
        <a class="icon-btn" href="/" aria-label="Back to calendar" title="Back to calendar">
            <Icon Name="arrow_back" />
        </a>
        <span class="billing-brand">Planno</span>
    </header>

    <nav class="tabs" role="tablist">
        <a class="tab @(IsInvoices ? "" : "active")" href="upgrade" role="tab" aria-selected="@(!IsInvoices)">Plans</a>
        <a class="tab @(IsInvoices ? "active" : "")" href="upgrade/invoices" role="tab" aria-selected="@IsInvoices">Subscriptions &amp; Invoices</a>
    </nav>

    <main class="billing-main">
        @if (_error is not null)
        {
            <div class="auth-alert" role="alert">@_error</div>
        }
        @if (_info is not null)
        {
            <div class="auth-alert info" role="status">@_info</div>
        }

        @if (_loading)
        {
            <div class="billing-loading"><span class="spinner dark" aria-label="Loading"></span></div>
        }
        else if (!IsInvoices)
        {
            <h1 class="billing-title">Get more out of Planno</h1>
            <p class="billing-sub">Choose a premium plan. Cancel anytime.</p>

            <div class="plans">
                @foreach (var plan in _plans)
                {
                    var current = IsCurrent(plan);
                    var saving = SavingPercent(plan);

                    <section class="plan @(saving is not null ? "featured" : "") @(current ? "current" : "")">
                        @if (current)
                        {
                            <span class="plan-badge">Your plan</span>
                        }
                        else if (saving is not null)
                        {
                            <span class="plan-badge">Save @saving%</span>
                        }

                        <h2 class="plan-name">@plan.Description</h2>
                        <div class="plan-price">
                            <span class="plan-amount">@Money(plan.Price)</span>
                            <span class="plan-per">@Per(plan.Interval)</span>
                        </div>
                        <div class="plan-note">
                            @(plan.Interval > 1 ? $"equals {Money(plan.Price / plan.Interval)} per month" : "billed monthly")
                        </div>

                        <ul class="plan-features">
                            @foreach (var feature in Features)
                            {
                                <li><Icon Name="check" Size="20" /><span>@feature</span></li>
                            }
                        </ul>

                        @if (current)
                        {
                            <button type="button" class="plan-btn" disabled>Current plan</button>
                        }
                        else
                        {
                            <button type="button" class="filled-btn plan-btn" @onclick="() => OpenCheckout(plan)">
                                @(IsPremium ? "Switch to this plan" : "Subscribe")
                            </button>
                        }
                    </section>
                }
            </div>
        }
        else
        {
            <h1 class="billing-title">Subscriptions &amp; Invoices</h1>

            <section class="card-block">
                <h2 class="block-title">Your subscription</h2>

                @if (_status is { IsPremium: true } status)
                {
                    <div class="sub-row">
                        <div class="sub-icon"><Icon Name="star" /></div>
                        <div class="sub-info">
                            <div class="sub-name">@status.Description</div>
                            <div class="sub-meta">Active until @Date(status.ExpiresAt)</div>
                        </div>
                    </div>
                    <div class="sub-actions">
                        <button type="button" class="text-btn danger" @onclick="() => _confirmCancel = true">Cancel</button>
                        <a class="filled-btn" href="upgrade">Change plan</a>
                    </div>
                }
                else
                {
                    <p class="muted">You currently don't have an active subscription.</p>
                    <div class="sub-actions">
                        <a class="filled-btn" href="upgrade">Upgrade</a>
                    </div>
                }
            </section>

            <section class="card-block">
                <h2 class="block-title">Invoices</h2>

                @if (_invoices.Count == 0)
                {
                    <p class="muted">No invoices yet.</p>
                }
                else
                {
                    <ul class="invoice-list">
                        @foreach (var invoice in _invoices)
                        {
                            <li class="invoice">
                                <div class="inv-icon"><Icon Name="credit_card" /></div>
                                <div class="inv-main">
                                    <div class="inv-desc">@invoice.Description</div>
                                    <div class="inv-meta">@invoice.InvoiceNumber · @Date(invoice.IssuedAt)</div>
                                </div>
                                <div class="inv-amount">@Money(invoice.Amount)</div>
                                <button type="button" class="icon-btn"
                                        aria-label="@($"Download invoice {invoice.InvoiceNumber}")" title="Download"
                                        disabled="@(_downloading is not null)"
                                        @onclick="() => DownloadAsync(invoice.InvoiceNumber)">
                                    @if (_downloading == invoice.InvoiceNumber) { <span class="spinner dark"></span> } else { <Icon Name="download" /> }
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    </main>
</div>

@if (_checkoutPlan is { } checkoutPlan)
{
    <div class="scrim">
        <div class="confirm checkout" role="dialog" aria-modal="true" aria-labelledby="checkout-title">
            @if (_purchase is { } purchase)
            {
                <h2 class="confirm-title tight" id="checkout-title">Thank you!</h2>
                <p class="co-text">
                    <strong>@checkoutPlan.Description</strong> is active until @Date(purchase.SubscriptionExpiresAt).
                    You can find your invoice @purchase.InvoiceNumber anytime under "Subscriptions &amp; Invoices".
                </p>
                <div class="confirm-actions">
                    <button type="button" class="text-btn" disabled="@(_downloading is not null)" @onclick="() => DownloadAsync(purchase.InvoiceNumber)">
                        Download invoice
                    </button>
                    <button type="button" class="filled-btn" @onclick="FinishCheckout">Done</button>
                </div>
            }
            else
            {
                <h2 class="confirm-title tight" id="checkout-title">@checkoutPlan.Description</h2>

                <div class="co-summary">
                    <span>Due today</span>
                    <strong>@Money(checkoutPlan.Price)</strong>
                </div>

                @if (IsPremium)
                {
                    <p class="co-text">Your current subscription will be replaced. The new term will start after the already paid period ends (from @Date(_status!.ExpiresAt)).</p>
                }

                @if (_checkoutError is not null)
                {
                    <div class="auth-alert" role="alert">@_checkoutError</div>
                }

                <EditForm Model="_card" OnValidSubmit="PayAsync" novalidate>
                    <DataAnnotationsValidator />

                    <div class="auth-fields">
                        <TextField Label="Card number" Autocomplete="cc-number" Autofocus="true" @bind-Value="_card.CardNumber" />
                        <div class="auth-row">
                            <TextField Label="Expiration date (MM/YY)" Autocomplete="cc-exp" @bind-Value="_card.Expiry" />
                            <TextField Label="CVC" Autocomplete="cc-csc" @bind-Value="_card.Cvc" />
                        </div>
                    </div>

                    <p class="co-hint">Demo – no actual payment will be processed.</p>

                    <div class="confirm-actions">
                        <button type="button" class="text-btn" disabled="@_busy" @onclick="CloseCheckout">Cancel</button>
                        <button type="submit" class="filled-btn" disabled="@_busy">
                            @if (_busy) { <span class="spinner" aria-label="Please wait"></span> } else { <span>Pay</span> }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@if (_confirmCancel && _status is { IsPremium: true } active)
{
    <div class="scrim">
        <div class="confirm" role="alertdialog" aria-modal="true" aria-labelledby="cancel-title">
            <h2 class="confirm-title tight" id="cancel-title">Cancel subscription?</h2>
            <p class="co-text">@active.Description will end immediately. Already paid time will not be refunded.</p>
            <div class="confirm-actions">
                <button type="button" class="text-btn" disabled="@_busy" @onclick="() => _confirmCancel = false">Cancel</button>
                <button type="button" class="filled-btn danger" disabled="@_busy" @onclick="CancelAsync">
                    @if (_busy) { <span class="spinner" aria-label="Please wait"></span> } else { <span>Confirm cancellation</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo EnUs = new("en-US");

    private static readonly string[] Features =
    [
        "All premium features of Planno",
        "PDF invoice for every payment",
        "Cancel anytime"
    ];

    [Parameter] public string? Tab { get; set; }

    private List<SubscriptionResponse> _plans = [];
    private SubscriptionStatusResponse? _status;
    private List<InvoiceResponse> _invoices = [];

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _info;
    private string? _downloading;

    private SubscriptionResponse? _checkoutPlan;
    private CheckoutModel _card = new();
    private CheckoutResponse? _purchase;
    private string? _checkoutError;

    private bool _confirmCancel;

    private bool IsInvoices => string.Equals(Tab, "invoices", StringComparison.OrdinalIgnoreCase);
    private bool IsPremium => _status?.IsPremium == true;

    private bool IsCurrent(SubscriptionResponse plan) => IsPremium && _status!.SubscriptionId == plan.Id;

    private int? SavingPercent(SubscriptionResponse plan)
    {
        var monthly = _plans.Where(p => p.Interval == 1).Select(p => (decimal?)p.Price).Min();
        if (plan.Interval <= 1 || monthly is not > 0) return null;

        var percent = (int)Math.Round((1 - plan.Price / (monthly.Value * plan.Interval)) * 100);
        return percent > 0 ? percent : null;
    }

    private static string Money(decimal amount) => amount.ToString("C", EnUs);

    private static string Per(int interval) => interval switch
    {
        1  => "/ month",
        12 => "/ year",
        _  => $"/ {interval} months"
    };

    private static string Date(DateTime? date) => date?.ToLocalTime().ToString("MMMM d, yyyy", EnUs) ?? "–";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(await AuthService.GetTokenAsync()))
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var plans = SubscriptionService.GetSubscriptionsAsync();
            var status = SubscriptionService.GetSubscriptionStatusAsync();
            var invoices = InvoiceService.GetInvoicesAsync();

            _plans = await plans ?? [];
            _status = await status;
            _invoices = await invoices ?? [];
            _error = null;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            await AuthService.LogoutAsync();
            Nav.NavigateTo("/login");
        }
        catch (HttpRequestException)
        {
            _error = "The server is unreachable. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCheckout(SubscriptionResponse plan)
    {
        _card = new();
        _purchase = null;
        _checkoutError = null;
        _checkoutPlan = plan;
    }

    private void CloseCheckout() => _checkoutPlan = null;

    private void FinishCheckout()
    {
        _checkoutPlan = null;
        _purchase = null;
        Nav.NavigateTo("upgrade/invoices");
    }

    private async Task PayAsync()
    {
        if (_checkoutPlan is not { } plan) return;

        _busy = true;
        _checkoutError = null;

        try
        {
            var result = await PaymentService.CheckoutAsync(_card.ToRequest(plan.Id));
            if (result is null)
            {
                _checkoutError = "Payment failed. Please check your card details.";
                return;
            }

            _purchase = result;
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _checkoutError = "The server is unreachable. Please try again later.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync()
    {
        _busy = true;

        try
        {
            if (!await SubscriptionService.CancelAsync())
            {
                _error = "Could not cancel the subscription.";
            }

            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _error = "The server is unreachable. Please try again later.";
        }
        finally
        {
            _busy = false;
            _confirmCancel = false;
        }
    }

    private async Task DownloadAsync(string invoiceNumber)
    {
        _downloading = invoiceNumber;
        _error = _info = null;

        try
        {
            var pdf = await InvoiceService.DownloadPdfAsync(invoiceNumber);
            if (pdf is not { Length: > 0 })
            {
                _error = "Could not load the invoice.";
                return;
            }

            var location = await DownloadService.SaveAsync($"{invoiceNumber}.pdf", pdf, "application/pdf");
            if (location is not null)
            {
                _info = $"Invoice saved: {location}";
            }
        }
        catch (HttpRequestException)
        {
            _error = "The server is unreachable. Please try again later.";
        }
        catch (Exception)
        {
            _error = "Could not save the invoice.";
        }
        finally
        {
            _downloading = null;
            FinishCheckout();
        }
    }
}